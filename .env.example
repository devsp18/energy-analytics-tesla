# Copy this file to .env and fill in real values. .env is gitignored — never commit real secrets.

# Same EIA key as energy-data-pipeline (free at https://www.eia.gov/opendata/register.php)
EIA_API_KEY=your_eia_api_key_here

# PostgreSQL — reuses the native Homebrew Postgres install from energy-data-pipeline,
# just a separate database/role for this project.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=energy_sql_analytics
POSTGRES_USER=energy_sql_user
POSTGRES_PASSWORD=change_me
